# Copy to .env and fill in. docker compose reads it for the container and for docker-compose.yml.

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Obsidian export: /app/vault inside the container; leave empty to disable it.
OBSIDIAN_DIR=/app/vault
# Host folder mounted at /app/vault (the vault, or a folder inside it).
OBSIDIAN_HOST_DIR=/srv/obsidian

# Host port.
PORT=3000

# Host user that owns data/ and the vault files (`id -u`, `id -g`).
APP_UID=1000
APP_GID=1000
